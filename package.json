{
  "name": "acquisition-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable, configuration-driven multi-client Acquisition Engine",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate": "tsx src/cli/validate.ts campaigns",
    "demo": "tsx src/cli/demo.ts",
    "prototype": "tsx scripts/demo-data.ts && tsx scripts/build-prototype.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
